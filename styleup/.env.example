# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose to browser

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...     # or pk_test_... for testing
STRIPE_SECRET_KEY=sk_live_...                      # or sk_test_... for testing
STRIPE_WEBHOOK_SECRET=whsec_...                    # from Stripe → Webhooks → your endpoint

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app  # your Vercel deployment URL
